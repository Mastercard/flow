<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>com.mastercard.test.flow.consumer</groupId>
	<artifactId>packaged-consumer</artifactId>
	<version>1.0-SNAPSHOT</version>
	<properties>
		<maven.compiler.release>17</maven.compiler.release>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<flow.version>1.1.8-SNAPSHOT</flow.version>
		<junit.version>5.10.0</junit.version>
		<platform.version>1.10.0</platform.version>
		<consumer.parallel>false</consumer.parallel>
		<consumer.classload>target/classload-${junit.version}-${consumer.parallel}.log</consumer.classload>
	</properties>
	<dependencyManagement>
		<dependencies>
			<dependency>
				<!-- First import wins: Flow's BOM inherits its build-time JUnit BOM. -->
				<groupId>org.junit</groupId>
				<artifactId>junit-bom</artifactId>
				<version>${junit.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>com.mastercard.test.flow</groupId>
				<artifactId>bom</artifactId>
				<version>${flow.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>
	<dependencies>
		<dependency>
			<groupId>com.mastercard.test.flow</groupId>
			<artifactId>assert-junit5</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.mastercard.test.flow</groupId>
			<artifactId>builder</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.mastercard.test.flow</groupId>
			<artifactId>model</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.mastercard.test.flow</groupId>
			<artifactId>message-text</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.15.0</version>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.5.3</version>
				<configuration>
					<failIfNoTests>true</failIfNoTests>
					<argLine>-Xlog:class+load=info:file=${consumer.classload}</argLine>
					<systemPropertyVariables>
						<consumer.parallel>${consumer.parallel}</consumer.parallel>
						<consumer.junit>${junit.version}</consumer.junit>
						<consumer.platform>${platform.version}</consumer.platform>
						<consumer.flow>${flow.version}</consumer.flow>
						<mctf.suppress.filter>true</mctf.suppress.filter>
					</systemPropertyVariables>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
