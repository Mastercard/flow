<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.mastercard.test.flow</groupId>
		<artifactId>assert</artifactId>
		<version>1.1.8-SNAPSHOT</version>
	</parent>
	<artifactId>assert-junit5</artifactId>
	<packaging>jar</packaging>
	<description>JUnit5 comparison components</description>

	<dependencies>

		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>assert-core</artifactId>
			<version>${project.version}</version>
		</dependency>

		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
		</dependency>

		<dependency>
			<!-- Public, baseline-compatible native execution notifications. Versions
			     remain selected by the consumer's coherent JUnit dependency set. -->
			<groupId>org.junit.platform</groupId>
			<artifactId>junit-platform-launcher</artifactId>
		</dependency>

		<dependency>
			<!-- Assert components use all of the model API, so it's a pain to mock -->
			<groupId>${project.groupId}</groupId>
			<artifactId>builder</artifactId>
			<version>${project.version}</version>
			<scope>test</scope>
		</dependency>

	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.pitest</groupId>
				<artifactId>pitest-maven</artifactId>
				<configuration>
					<!-- Match Surefire's four default controlling-test naming patterns. Auxiliary
					     native factories require their controller's registry/configuration;
					     they remain exercised by its nested Launcher, not as standalone tests. -->
					<targetTests>
						<param>com.mastercard.test.flow.assrt.junit5.Test*</param>
						<param>com.mastercard.test.flow.assrt.junit5.*Test</param>
						<param>com.mastercard.test.flow.assrt.junit5.*Tests</param>
						<param>com.mastercard.test.flow.assrt.junit5.*TestCase</param>
					</targetTests>
					<!-- I'm not saying these *have* to stay where they are, just that 
				     we shouldn't let them slip down by accident -->
					<mutationThreshold>82</mutationThreshold>
					<coverageThreshold>97</coverageThreshold>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
